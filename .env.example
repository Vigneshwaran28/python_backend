# TaskFlow Python Backend Configuration (Shared Neon PostgreSQL DB)
DATABASE_URL="postgresql://<user>:<password>@<neon-host>/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<neon-host>/neondb?sslmode=require"

# Shared JWT secret with Node.js backend to allow cross-backend JWT verification
JWT_SECRET="<your-secure-jwt-secret-here>"

# Environment and Server Options
ENV="production"
PORT=5000
DEBUG=False
TRUST_PROXY=True

# Neon Integrations
NEON_BRANCH=production
NEON_AUTH_BASE_URL=https://ep-long-paper-aob1b15e.neonauth.c-2.ap-southeast-1.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-long-paper-aob1b15e.neonauth.c-2.ap-southeast-1.aws.neon.tech/neondb/auth/.well-known/jwks.json

# CORS allowed origins (comma-separated, leave blank for wildcard or dev reflection)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,https://titanflow-svc6.onrender.com"
